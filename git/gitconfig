# Git aliases shared across machines. install.sh includes this from ~/.gitconfig.
#
# The branch used by `git prm` defaults to "main". Override it globally
# (./install.sh --main-branch master) or per repo:
#   git config dotfiles.mainBranch master        # just this repo

[alias]
	# Last 20 commits as a graph of HEAD plus its upstream (if any), so you can
	# see where the local branch and origin/<branch> have diverged.
	# Extra args pass through, e.g. `git lg -50` or `git lg -- path/`.
	lg = "!f() { \
		up=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null); \
		git log --graph --date=relative -n 20 \
			--pretty='%C(yellow)%h%C(reset)%C(auto)%d%C(reset) %s %C(dim)(%ad, %an)%C(reset)' \
			HEAD $up \"$@\"; \
	}; f"

	# Same as lg but across every local and remote branch.
	lga = lg --all

	# Plain, graph-free summary of the last 10 commits.
	ls = log --oneline --decorate -n 10

	st = status -sb

	# Rebase the current branch on top of origin's main branch.
	prm = "!git pull --rebase origin \"$(git config dotfiles.mainBranch || echo main)\""

	# Push the current branch and track it on origin.
	psu = push --set-upstream origin HEAD

	# Safer force push: refuses if someone else pushed in the meantime.
	pf = push --force-with-lease

	# Fold staged changes into the last commit, keeping its message.
	amend = commit --amend --no-edit

	# Undo the last commit, keeping its changes staged.
	undo = reset --soft HEAD~1

	wl = worktree list

	# New worktree on a new branch <name>, started from origin's main branch
	# (dotfiles.mainBranch, default main). It goes next to the main checkout:
	# ~/src/repo + `git wcm feat/x` -> ~/src/repo-feat-x
	# The branch doesn't track origin/main, so `git psu` sets its upstream.
	# Prints the new path last so the shell `gwcm` can cd into it.
	wcm = "!f() { \
		[ -n \"$1\" ] || { echo 'usage: git wcm <branch-name>' >&2; return 1; }; \
		base=$(git config dotfiles.mainBranch || echo main); \
		main=$(git worktree list --porcelain | sed -n '1s/^worktree //p'); \
		path=\"$main-$(printf %s \"$1\" | tr / -)\"; \
		git fetch -q origin \"$base\" && \
		git worktree add --no-track -b \"$1\" \"$path\" \"origin/$base\" >&2 && \
		echo \"$path\"; \
	}; f"

	# Remove a worktree by branch name (as given to wcm) or by path.
	# No --force: git refuses if it has modified or untracked files, and any
	# git error and exit code pass straight through. The branch is kept, so
	# commits made there are never lost; delete it separately with
	# `git branch -d <name>` (which itself refuses if it's unmerged).
	# Prints the main checkout's path last so the shell `gwrm` can cd there.
	wrm = "!f() { \
		[ $# -eq 1 ] || { echo 'usage: git wrm <branch-name|path>' >&2; return 1; }; \
		cd \"./$GIT_PREFIX\" || return; \
		main=$(git worktree list --porcelain | sed -n '1s/^worktree //p'); \
		byname=\"$main-$(printf %s \"$1\" | tr / -)\"; \
		if [ -d \"$1\" ]; then target=$1; elif [ -d \"$byname\" ]; then target=$byname; else target=$1; fi; \
		git worktree remove \"$target\" && echo \"$main\"; \
	}; f"

	# Forget worktrees whose folders were deleted by hand. Only touches
	# git's own bookkeeping, never files; -v lists everything it prunes.
	wp = worktree prune -v
